# Build Configuration
BUILD_ENV=release

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5000

# Electron
NODE_ENV=production

# Optional: Code Signing (Windows)
# WIN_CERT_FILE=path/to/certificate.pfx
# WIN_CERT_PASSWORD=certificate_password

# Optional: Apple Notarization (macOS)
# APPLE_TEAM_ID=your_team_id
# APPLE_ID=your_apple_id
# APPLE_PASSWORD=your_app_password
